// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SHIPPER
  DISPATCHER
  DRIVER
  ADMIN
}

enum CarrierType {
  ASSET_BASED
  BROKER
}

enum SupplierKind {
  MILL
  WHOLESALER
  OTHER
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LoadStatus {
  POSTED
  BOOKED
  ASSIGNED
  IN_TRANSIT
  DELIVERED
  CANCELLED
  /**
   * Firm Rate past 7-day grace, or Open bid window ended (cycle 1) — shipper must resolve.
   * Hidden from the carrier board until resolved.
   */
  NEEDS_REPOST
  /**
   * Shipper declined repost, or Open bid hit 2 cycles without a book.
   * Hidden from both parties' boards; retained for history / posted-rate analytics.
   */
  UNLISTED
}

enum IncidentType {
  DROPPED_LOAD
  NO_PICKUP
  NON_RESPONSIVE
}

enum DispatchLinkStatus {
  ACTIVE
  EXPIRED
  COMPLETED
}

enum OfferCurrency {
  USD
  CAD
}

enum RateObservationSource {
  APP
  IMPORT
  /** Supplier posted rate (Firm Rate or Open bid target) — not a booked move. */
  POSTED
  /** Agreed booked rate on this load. */
  BOOKED
}

/**
 * Lifecycle tag on posted-lane analytics (separate from booked freight market stats).
 */
enum PostedLaneOutcome {
  OPEN
  BOOKED
  DECLINED_REPOST
  BID_CYCLE_REMOVED
}

/**
 * Who may see a posted load on the open board (dispatchers).
 */
enum LoadCarrierVisibilityMode {
  OPEN
  TIER_ASSIGNED
}

enum LoadNoticeChannel {
  IN_APP
  EMAIL
}

enum LoadNoticeStatus {
  PENDING
  DELIVERED
  SKIPPED
}

enum DateChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

/**
 * How a posted load is priced on the board.
 * TAKE_IT = posted Firm Rate (book as-is; optional counters).
 * OPEN_BID = carriers name a price until the window closes or the mill accepts.
 */
enum LoadRateMode {
  TAKE_IT
  OPEN_BID
}

enum LoadBidKind {
  BID
  COUNTER
}

enum LoadBidStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
  EXPIRED
}

model Company {
  id                    String             @id @default(cuid())
  legalName             String             @unique
  /**
   * 2–3 letter tracking acronym for LOB load refs (e.g. NRL for North Ridge Lumber).
   */
  acronym               String?            @unique @db.VarChar(3)
  dotNumber             String?            @unique
  mcNumber              String?            @unique
  carrierType           CarrierType?
  verificationStatus    VerificationStatus @default(PENDING)
  reliabilityScore      Int                @default(100)
  factoringEligible     Boolean            @default(false)
  analyticsSubscriber   Boolean            @default(false)
  supplierKind          SupplierKind?
  /**
   * Fleet & capabilities — shown to shippers after a load is booked.
   */
  fleetTruckCount       Int?
  fleetTrailerCount     Int?
  /**
   * JSON string array of equipment codes or labels, e.g. ["SB","Tri"].
   */
  trailerEquipmentTypes String?
  /**
   * Short narrative for shippers (service area, lanes, certifications).
   */
  carrierProfileBlurb   String?
  /**
   * Single-truck operators; admin verification still uses verificationStatus.
   */
  isOwnerOperator       Boolean            @default(false)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  users                 User[]
  postedLoads           Load[]                    @relation("ShipperLoads")
  bookings              Booking[]
  preferredLanes        PreferredLane[]
  emptyMileSetting      EmptyMileSetting?
  documents             Document[]
  reportedIncidents     Incident[]                @relation("IncidentReporter")
  incidentsAgainst      Incident[]                @relation("IncidentTarget")
  capacityOffers        CapacityOffer[]
  capacityInterestsAsShipper CapacityInterest[] @relation("CapacityInterestShipper")
  capacityInterestsAsCarrier CapacityInterest[] @relation("CapacityInterestCarrier")
  blocksCarriers        ShipperCarrierExclusion[] @relation("ShipperBlocksCarrier")
  blockedByShippers     ShipperCarrierExclusion[] @relation("CarrierBlockedByShipper")
  shipperCarrierTiers   ShipperCarrierTier[]      @relation("ShipperSavesCarrierTiers")
  carrierInShipperTiers ShipperCarrierTier[]      @relation("CarrierInShipperTiers")
  loadCarrierTiers      LoadCarrierTier[]
  loadExclusionsAgainst LoadCarrierExclusion[]    @relation("CarrierLoadExclusion")
  loadChangeNotices     LoadChangeNotice[]         @relation("CarrierLoadNotices")
  dateChangesProposed   LoadDateChangeRequest[]   @relation("DateChangeFromCarrier")
  loadTemplates         LoadTemplate[]            @relation("CompanyLoadTemplates")
  savedLanes            SavedLane[]               @relation("CompanySavedLanes")
  loadBids              LoadBid[]                 @relation("CarrierLoadBids")
  shipperLoadAlerts     ShipperLoadAlert[]        @relation("CompanyShipperAlerts")
}

/**
 * Supplier excludes a carrier: hide their capacity from this shipper and hide this shipper's loads from that carrier.
 */
model ShipperCarrierExclusion {
  id               String   @id @default(cuid())
  shipperCompanyId String
  carrierCompanyId String
  createdAt        DateTime @default(now())

  shipperCompany Company @relation("ShipperBlocksCarrier", fields: [shipperCompanyId], references: [id], onDelete: Cascade)
  carrierCompany Company @relation("CarrierBlockedByShipper", fields: [carrierCompanyId], references: [id], onDelete: Cascade)

  @@unique([shipperCompanyId, carrierCompanyId])
  @@index([shipperCompanyId])
  @@index([carrierCompanyId])
}

/**
 * Company-level preferred carrier groups (T1 / T2 / T3). Membership is edited rarely;
 * each load picks which groups can see it.
 */
model ShipperCarrierTier {
  id               String   @id @default(cuid())
  shipperCompanyId String
  carrierCompanyId String
  /**
   * 1 = primary / preferred; 2–3 = backup groups.
   */
  tier             Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  shipperCompany Company @relation("ShipperSavesCarrierTiers", fields: [shipperCompanyId], references: [id], onDelete: Cascade)
  carrierCompany Company @relation("CarrierInShipperTiers", fields: [carrierCompanyId], references: [id], onDelete: Cascade)

  @@unique([shipperCompanyId, carrierCompanyId])
  @@index([shipperCompanyId, tier])
  @@index([carrierCompanyId])
}

model User {
  id             String   @id @default(cuid())
  authProviderId String?  @unique
  email          String   @unique
  name           String
  role           UserRole
  companyId      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company            Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdLoads       Load[]         @relation("LoadCreator")
  assignedDispatches DispatchLink[] @relation("DispatchAssignedBy")
  loadTemplates      LoadTemplate[] @relation("LoadTemplateCreator")
  savedLanes         SavedLane[]    @relation("SavedLaneCreator")
  loadChangeNotices  LoadChangeNotice[] @relation("LoadNoticeRecipient")
  dateChangesProposed LoadDateChangeRequest[] @relation("DateChangeProposer")
  dateChangesReviewed LoadDateChangeRequest[] @relation("DateChangeReviewer")
  loadBidsSubmitted   LoadBid[]               @relation("LoadBidSubmitter")
  loadBidsReviewed    LoadBid[]               @relation("LoadBidReviewer")
  shipperLoadAlerts   ShipperLoadAlert[]      @relation("ShipperAlertRecipient")
  capacityInterestsCreated CapacityInterest[] @relation("CapacityInterestCreator")
  capacityInterestsReviewed CapacityInterest[] @relation("CapacityInterestReviewer")
}

model Load {
  id                    String                    @id @default(cuid())
  referenceNumber       String                    @unique
  /**
   * Shipper-supplied external identifier (TMS load id, mill ticket, PO, etc.).
   * Optional, but unique per shipper company when present — gives bulk
   * uploads safe idempotency: re-running the same CSV won't double-post,
   * and integrators can use it as an upsert key.
   */
  externalRef           String?
  originCity            String
  originState           String
  originZip             String
  destinationCity       String
  destinationState      String
  destinationZip        String
  weightLbs             Int
  equipmentType         String
  isRush                Boolean                   @default(false)
  isPrivate             Boolean                   @default(false)
  status                LoadStatus                @default(POSTED)
  offerCurrency         OfferCurrency             @default(CAD)
  offeredRateUsd        Decimal?                  @db.Decimal(10, 2)
  /**
   * TAKE_IT (default): posted rate is the pay rate. OPEN_BID: carriers submit bids.
   */
  rateMode              LoadRateMode              @default(TAKE_IT)
  /**
   * When TAKE_IT, mill may allow carriers to counter instead of booking the posted rate.
   */
  allowCounterOffers    Boolean                   @default(false)
  /**
   * When OPEN_BID, bidding closes at this time (unless a bid is accepted sooner).
   * Hard-capped at 72h from window / cycle start.
   */
  bidWindowExpiresAt    DateTime?
  /**
   * Open bid cycles on this same load id (max 2). Cycle 1 ends → shipper may reopen;
   * cycle 2 ends without accept → UNLISTED.
   */
  bidCycleCount         Int                       @default(1)
  /**
   * When status became NEEDS_REPOST (in-app alert timestamp).
   */
  needsRepostAt         DateTime?
  marketRateUsd         Decimal?                  @db.Decimal(10, 2)
  finalCostUsd          Decimal?                  @db.Decimal(10, 2)
  uniquePickupCode      String?
  shipperCompanyId      String
  createdByUserId       String
  requestedPickupAt     DateTime
  /**
   * Expected delivery date (optional on legacy rows; required on new supplier posts).
   */
  requestedDeliveryAt   DateTime?
  /**
   * Free-form structured payload (legacy + supplier extras). lumber.* mirrors first-class columns.
   */
  extendedPosting       Json?
  carrierVisibilityMode LoadCarrierVisibilityMode @default(OPEN)
  /**
   * When true (and not rush), tier groups unlock on a schedule instead of all at once.
   */
  tierStagingEnabled    Boolean                   @default(false)
  /**
   * Hours T1-only before T2 carriers unlock (staging). Typical default 24.
   */
  tier1ExclusiveHours   Int?
  /**
   * Additional hours after T2 unlock before T3 unlocks (staging). Typical default 24.
   */
  tier2ExclusiveHours   Int?

  /**
   * ---- First-class lumber spec columns (mirrored from extendedPosting.lumber) ----
   */
  /**
   * /**
   * /**
   * /** DIMENSIONAL | BOARDS | TIMBERS | PANELS | ENGINEERED | BUNDLES | POLES | PELLETS | CHIPS | MILLWORK | OTHER
   */
  lumberCategory         String?
  /**
   * SPF | DF | DF_LARCH | SYP | HEM_FIR | WRC | YELLOW_CEDAR | WHITE_PINE | PONDEROSA | OAK | MAPLE | BIRCH | ASH | POPLAR | MIXED | OTHER
   */
  lumberSpecies          String?
  lumberGrade            String?
  /**
   * GREEN | AD | KD | MC19 | MC15 | MC12
   */
  lumberDryness          String?
  /**
   * NONE | ACQ | MCA | CCA | BORATE | FIRE_RETARDANT | BROWN_STAIN | ANTI_SAPSTAIN
   */
  lumberTreatment        String?
  /**
   * OSB | PLY_SOFT | PLY_HARD | MDF | MDO | HDF | PARTICLEBOARD | LVL | LSL | I_JOIST | GLULAM | CLT
   */
  lumberPanelType        String?
  lumberNominalSize      String?
  lumberLengthFt         Float?
  lumberPieceCount       Int?
  lumberBundleCount      Int?
  lumberMbf              Float?
  /**
   * STANDARD | PAPER_WRAP | PLASTIC_WRAP | BANDED_ONLY | PALLETIZED | BULK
   */
  lumberPackaging        String?
  /**
   * SIDE_LOAD | REAR_LOAD | OVERHEAD | LIVE_LOAD | DROP_TRAILER
   */
  lumberLoadingMethod    String?
  lumberFragile          Boolean?
  lumberWeatherSensitive Boolean?
  lumberExportShipment   Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shipperCompany      Company                @relation("ShipperLoads", fields: [shipperCompanyId], references: [id], onDelete: Restrict)
  createdBy           User                   @relation("LoadCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  booking             Booking?
  dispatchLink        DispatchLink?
  incidents           Incident[]
  laneRateObservation LaneRateObservation?
  carrierTiers        LoadCarrierTier[]
  excludedCarriers    LoadCarrierExclusion[] @relation("LoadExcludesCarrier")
  changeNotices       LoadChangeNotice[]
  dateChangeRequests  LoadDateChangeRequest[]
  bids                LoadBid[]
  shipperAlerts       ShipperLoadAlert[]
  capacityInterests   CapacityInterest[]

  @@unique([shipperCompanyId, externalRef], name: "Load_shipper_externalRef_unique")
  @@index([lumberSpecies])
  @@index([lumberPanelType])
  @@index([lumberCategory])
  @@index([originState, destinationState, requestedPickupAt])
  @@index([shipperCompanyId, createdAt])
  @@index([shipperCompanyId, status])
  @@index([rateMode, status])
  @@index([bidWindowExpiresAt])
}

/**
 * Carrier bid (open-bid loads) or counter on a Firm Rate load.
 * Accepting a pending bid books the load at this amount.
 */
model LoadBid {
  id                String        @id @default(cuid())
  loadId            String
  carrierCompanyId  String
  submittedByUserId String
  kind              LoadBidKind
  status            LoadBidStatus @default(PENDING)
  amountUsd         Decimal       @db.Decimal(10, 2)
  currency          OfferCurrency
  note              String?
  expiresAt         DateTime
  reviewedAt        DateTime?
  reviewedByUserId  String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  load             Load    @relation(fields: [loadId], references: [id], onDelete: Cascade)
  carrierCompany   Company @relation("CarrierLoadBids", fields: [carrierCompanyId], references: [id], onDelete: Cascade)
  submittedBy      User    @relation("LoadBidSubmitter", fields: [submittedByUserId], references: [id], onDelete: Restrict)
  reviewedBy       User?   @relation("LoadBidReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([loadId, status])
  @@index([carrierCompanyId, status])
  @@index([expiresAt])
}

/**
 * Reusable post-load template owned by a shipper company. Power-user mills
 * stamp out the same 2x4 lane × spec week after week — saving as a template
 * lets them re-post in 2 clicks.
 */
model LoadTemplate {
  id              String  @id @default(cuid())
  companyId       String
  createdByUserId String
  name            String
  /**
   * Optional shorthand displayed in the picker (e.g. "PG → Boise · Tri · 2x4-8").
   */
  shortLabel      String?

  originCity       String?
  originState      String?
  originZip        String?
  destinationCity  String?
  destinationState String?
  destinationZip   String?
  equipmentType    String?
  weightLbs        Int?
  isRush           Boolean       @default(false)
  isPrivate        Boolean       @default(false)
  defaultRateUsd   Decimal?      @db.Decimal(10, 2)
  defaultCurrency  OfferCurrency @default(CAD)
  notes            String?

  /**
   * Full LumberSpec snapshot.
   */
  lumberSpec Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company @relation("CompanyLoadTemplates", fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User    @relation("LoadTemplateCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([companyId, name])
}

/**
 * Address-only saved lane. Lighter than a LoadTemplate — just pickup +
 * delivery endpoints — so a mill can quickly fill route fields without
 * inheriting product/rate/equipment from a snapshot. Re-using a saved lane
 * bumps useCount + lastUsedAt so the picker can sort by "what you actually
 * use".
 */
model SavedLane {
  id              String  @id @default(cuid())
  companyId       String
  createdByUserId String
  /**
   * User-supplied friendly name (e.g. "PG Mill → Boise yard"). Optional.
   */
  label           String?

  originCity         String
  originState        String
  originZip          String
  /**
   * Optional street/yard/dock detail (free-form, displayed but not parsed).
   */
  originAddress      String?
  originPhone        String?
  destinationCity    String
  destinationState   String
  destinationZip     String
  destinationAddress String?
  destinationPhone   String?

  useCount   Int       @default(0)
  lastUsedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company @relation("CompanySavedLanes", fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User    @relation("SavedLaneCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([companyId, lastUsedAt])
  @@index([companyId, useCount])
}

/**
 * When carrierVisibilityMode is TIER_ASSIGNED, only listed carriers may see the posted load.
 * unlockAt supports staged release (T1 now, T2/T3 later) without a background job.
 */
model LoadCarrierTier {
  id               String   @id @default(cuid())
  loadId           String
  carrierCompanyId String
  /**
   * 1 = first preference group; same-day visibility for all tiers in MVP.
   */
  tier             Int      @default(1)
  /**
   * Carrier may see the load once this timestamp is reached (UTC).
   */
  unlockAt         DateTime @default(now())
  createdAt        DateTime @default(now())

  load           Load    @relation(fields: [loadId], references: [id], onDelete: Cascade)
  carrierCompany Company @relation(fields: [carrierCompanyId], references: [id], onDelete: Cascade)

  @@unique([loadId, carrierCompanyId])
  @@index([loadId])
  @@index([unlockAt])
}

/**
 * In-app / email-pending notice when a booked load changes (edit, date approve, etc.).
 * Email delivery is deferred (Outlook/manual for now); rows stay PENDING for EMAIL.
 */
model LoadChangeNotice {
  id                 String            @id @default(cuid())
  loadId             String
  carrierCompanyId   String
  recipientUserId    String?
  recipientEmail     String?
  title              String
  summary            String
  changes            Json?
  channel            LoadNoticeChannel @default(EMAIL)
  status             LoadNoticeStatus  @default(PENDING)
  createdAt          DateTime          @default(now())

  load             Load     @relation(fields: [loadId], references: [id], onDelete: Cascade)
  carrierCompany   Company  @relation("CarrierLoadNotices", fields: [carrierCompanyId], references: [id], onDelete: Cascade)
  recipientUser    User?    @relation("LoadNoticeRecipient", fields: [recipientUserId], references: [id], onDelete: SetNull)

  @@index([loadId, createdAt])
  @@index([carrierCompanyId, status])
  @@index([recipientUserId, status])
}

/**
 * Supplier alerts: Firm Rate past grace, bid window ended, 2-cycle removal.
 * v1: IN_APP delivered. EMAIL rows stay PENDING until outbound mail is live.
 */
model ShipperLoadAlert {
  id              String            @id @default(cuid())
  loadId          String
  companyId       String
  recipientUserId String?
  kind            String
  title           String
  body            String
  channel         LoadNoticeChannel @default(IN_APP)
  status          LoadNoticeStatus  @default(PENDING)
  resolvedAt      DateTime?
  createdAt       DateTime          @default(now())

  load          Load    @relation(fields: [loadId], references: [id], onDelete: Cascade)
  company       Company @relation("CompanyShipperAlerts", fields: [companyId], references: [id], onDelete: Cascade)
  recipientUser User?   @relation("ShipperAlertRecipient", fields: [recipientUserId], references: [id], onDelete: SetNull)

  @@index([companyId, status, createdAt])
  @@index([loadId])
  @@index([recipientUserId, status])
}

/**
 * Carrier proposes a new pickup/delivery date; supplier approves or rejects.
 */
model LoadDateChangeRequest {
  id                   String                  @id @default(cuid())
  loadId               String
  proposedByUserId     String
  proposedByCompanyId  String
  proposedPickupAt     DateTime?
  proposedDeliveryAt   DateTime?
  note                 String?
  status               DateChangeRequestStatus @default(PENDING)
  reviewedByUserId     String?
  reviewedAt           DateTime?
  reviewNote           String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  load              Load    @relation(fields: [loadId], references: [id], onDelete: Cascade)
  proposedByUser    User    @relation("DateChangeProposer", fields: [proposedByUserId], references: [id], onDelete: Restrict)
  proposedByCompany Company @relation("DateChangeFromCarrier", fields: [proposedByCompanyId], references: [id], onDelete: Cascade)
  reviewedByUser    User?   @relation("DateChangeReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([loadId, status])
  @@index([proposedByCompanyId, status])
}

/**
 * Carrier cannot see this specific load (even if OPEN or listed in a tier).
 */
model LoadCarrierExclusion {
  id               String   @id @default(cuid())
  loadId           String
  carrierCompanyId String
  createdAt        DateTime @default(now())

  load           Load    @relation("LoadExcludesCarrier", fields: [loadId], references: [id], onDelete: Cascade)
  carrierCompany Company @relation("CarrierLoadExclusion", fields: [carrierCompanyId], references: [id], onDelete: Cascade)

  @@unique([loadId, carrierCompanyId])
  @@index([loadId])
}

model LaneRateObservation {
  id              String                @id @default(cuid())
  observedAt      DateTime
  originState     String
  destState       String
  originCityCanon String
  destCityCanon   String
  originZip5      String                @default("")
  destZip5        String                @default("")
  equipmentNorm   String
  /**
   * Posted (asking) rate for this load. Market "booked freight" analytics should prefer bookedRateUsd.
   */
  rateUsd         Decimal               @db.Decimal(12, 2)
  /**
   * Agreed book rate when the load books; null while still open / unlisted without a book.
   */
  bookedRateUsd   Decimal?              @db.Decimal(12, 2)
  bookedAt        DateTime?
  outcome         PostedLaneOutcome     @default(OPEN)
  offerCurrency   OfferCurrency         @default(CAD)
  source          RateObservationSource @default(APP)
  loadId          String?               @unique
  load            Load?                 @relation(fields: [loadId], references: [id], onDelete: Cascade)

  @@index([observedAt])
  @@index([originState, destState])
  @@index([originState, destState, originCityCanon, destCityCanon])
  @@index([outcome, observedAt])
  @@index([source, observedAt])
}

model Booking {
  id               String        @id @default(cuid())
  loadId           String        @unique
  carrierCompanyId String
  agreedCurrency   OfferCurrency @default(CAD)
  agreedRateUsd    Decimal       @db.Decimal(10, 2)
  bookedAt         DateTime      @default(now())
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  load           Load    @relation(fields: [loadId], references: [id], onDelete: Restrict)
  carrierCompany Company @relation(fields: [carrierCompanyId], references: [id], onDelete: Restrict)
}

model DispatchLink {
  id                String             @id @default(cuid())
  loadId            String             @unique
  token             String             @unique
  driverName        String
  driverPhone       String?
  driverEmail       String?
  assignedByUserId  String
  expiresAt         DateTime
  /**
   * Carrier-selected driver packet: which haul fields + dispatcher notes.
   * Rate is never stored here. Shape: { include: Record<string, boolean>, notes: string }.
   */
  driverPacket      Json?
  status            DispatchLinkStatus @default(ACTIVE)
  pickupConfirmedAt DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  load        Load      @relation(fields: [loadId], references: [id], onDelete: Restrict)
  assignedBy  User      @relation("DispatchAssignedBy", fields: [assignedByUserId], references: [id], onDelete: Restrict)
  podDocument Document?
}

model Document {
  id             String    @id @default(cuid())
  companyId      String?
  dispatchLinkId String?   @unique
  kind           String
  fileUrl        String
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())

  company      Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  dispatchLink DispatchLink? @relation(fields: [dispatchLinkId], references: [id], onDelete: SetNull)
}

model Incident {
  id                  String       @id @default(cuid())
  loadId              String
  reportedByCompanyId String
  targetCompanyId     String
  type                IncidentType
  note                String?
  scoreDelta          Int          @default(-10)
  createdAt           DateTime     @default(now())

  load              Load    @relation(fields: [loadId], references: [id], onDelete: Restrict)
  reportedByCompany Company @relation("IncidentReporter", fields: [reportedByCompanyId], references: [id], onDelete: Restrict)
  targetCompany     Company @relation("IncidentTarget", fields: [targetCompanyId], references: [id], onDelete: Restrict)
}

model PreferredLane {
  id             String   @id @default(cuid())
  companyId      String
  originZip      String
  destinationZip String
  createdAt      DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, originZip, destinationZip])
}

model EmptyMileSetting {
  id             String   @id @default(cuid())
  companyId      String   @unique
  rateUsdPerMile Decimal  @db.Decimal(8, 2)
  maxEmptyMiles  Int      @default(150)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

enum CapacityInterestStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
  EXPIRED
}

/**
 * Carrier-posted lane capacity; shipper-facing listings omit carrier identity until
 * a CapacityInterest is accepted (then booking reveals identity on the load).
 */
model CapacityOffer {
  id               String   @id @default(cuid())
  carrierCompanyId String
  originZip        String
  originCity       String?
  originState      String?
  destinationZip   String
  destinationCity  String?
  destinationState String?
  equipmentType    String
  askingRateUsd    Decimal  @db.Decimal(10, 2)
  notes            String?
  /**
   * OPEN | MATCHED | CANCELLED
   */
  status           String   @default("OPEN")
  /**
   * First day this capacity is offered (inclusive).
   */
  availableFrom    DateTime @default(now())
  /**
   * Last day offered (inclusive); max span vs availableFrom is 5 days (enforced in API).
   */
  availableUntil   DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  carrier   Company            @relation(fields: [carrierCompanyId], references: [id], onDelete: Cascade)
  interests CapacityInterest[]

  @@index([status])
  @@index([originZip, destinationZip])
  @@index([availableUntil])
}

/**
 * Supplier requests an anonymous capacity offer for one of their posted loads.
 * Carrier Accept books the load; identity stays hidden until then.
 */
model CapacityInterest {
  id                String                 @id @default(cuid())
  capacityOfferId   String
  loadId            String
  shipperCompanyId  String
  carrierCompanyId  String
  status            CapacityInterestStatus @default(PENDING)
  note              String?
  createdByUserId   String
  reviewedAt        DateTime?
  reviewedByUserId  String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  capacity   CapacityOffer @relation(fields: [capacityOfferId], references: [id], onDelete: Cascade)
  load       Load          @relation(fields: [loadId], references: [id], onDelete: Cascade)
  shipper    Company       @relation("CapacityInterestShipper", fields: [shipperCompanyId], references: [id], onDelete: Cascade)
  carrier    Company       @relation("CapacityInterestCarrier", fields: [carrierCompanyId], references: [id], onDelete: Cascade)
  createdBy  User          @relation("CapacityInterestCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  reviewedBy User?         @relation("CapacityInterestReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@unique([capacityOfferId, loadId])
  @@index([carrierCompanyId, status])
  @@index([shipperCompanyId, status])
  @@index([loadId, status])
}

/**
 * Global forever counter for LOB load reference sequence (starts at 1000).
 * Format: LOB-{ACRONYM}-{YY}-{NNNN}
 */
model LoadRefCounter {
  id    String @id @default("global")
  next  Int    @default(1000)
}
